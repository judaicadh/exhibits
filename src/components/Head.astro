---
// Extends Starlight's default <head> to add a social share image
// (og:image / twitter:image) for every page. Uses the page's hero image
// when one is set, otherwise falls back to the site-wide default card.
import Default from '@astrojs/starlight/components/Head.astro';

const { entry } = Astro.locals.starlightRoute;
const site = Astro.site ?? new URL('https://exhibits.judaicadhpenn.org');

const DEFAULT_IMAGE = new URL('/assets/og-image.png', site).href;

let imageUrl = DEFAULT_IMAGE;
let width = '1200';
let height = '630';
let alt = 'Judaica Exhibitions — online exhibitions from Penn Libraries';

// hero.image can be { file, alt } (single) or { light, dark, alt } — we only
// use the single-file form for social previews. `file` is resolved by Astro's
// image() schema helper into an ImageMetadata object (src/width/height).
const hero = entry?.data?.hero?.image;
const file = hero && 'file' in hero ? hero.file : undefined;

if (file && typeof file === 'object' && 'src' in file) {
	imageUrl = new URL(file.src, site).href;
	if (file.width) width = String(file.width);
	if (file.height) height = String(file.height);
	alt = (hero.alt && hero.alt.trim()) || entry?.data?.title || alt;
}

// --- Structured data (JSON-LD) ---------------------------------------------
const orgId = new URL('#organization', site).href;
const siteId = new URL('#website', site).href;
const pageUrl = new URL(Astro.url.pathname, site).href;
const title = entry?.data?.title ?? 'Judaica Exhibitions';
const isHome = entry?.data?.template === 'splash';

const organization = {
	'@type': 'Organization',
	'@id': orgId,
	name: 'Judaica Digital Humanities at Penn Libraries',
	url: site.href,
	logo: {
		'@type': 'ImageObject',
		url: new URL('/android-chrome-512x512.png', site).href,
		width: 512,
		height: 512,
	},
	sameAs: ['https://judaicadhpenn.org'],
};

const website = {
	'@type': 'WebSite',
	'@id': siteId,
	url: site.href,
	name: 'Judaica Exhibitions',
	description: 'Online exhibitions from Judaica at Penn Libraries',
	inLanguage: 'en',
	publisher: { '@id': orgId },
};

let graph;
if (isHome) {
	graph = [organization, website];
} else {
	// `date` frontmatter is a free-form year/range (e.g. "2011–2012", "1996");
	// pull the first 4-digit year for a valid ISO 8601 `datePublished`.
	const yearMatch = String(entry?.data?.date ?? '').match(/\d{4}/);
	const article = {
		'@type': 'Article',
		'@id': `${pageUrl}#article`,
		headline: title.length > 110 ? title.slice(0, 107).trimEnd() + '…' : title,
		name: title,
		...(entry?.data?.description ? { description: entry.data.description } : {}),
		image: imageUrl,
		inLanguage: 'en',
		url: pageUrl,
		isPartOf: { '@id': siteId },
		author: { '@id': orgId },
		publisher: { '@id': orgId },
		...(yearMatch ? { datePublished: yearMatch[0] } : {}),
	};
	const breadcrumb = {
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Exhibits', item: site.href },
			{ '@type': 'ListItem', position: 2, name: title, item: pageUrl },
		],
	};
	graph = [organization, website, article, breadcrumb];
}

// Escape `<` to prevent a `</script>` breakout from any field content.
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(
	/</g,
	'\\u003c'
);
---

<Default><slot /></Default>

<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content={width} />
<meta property="og:image:height" content={height} />
<meta property="og:image:alt" content={alt} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" is:inline set:html={jsonLd} />
